# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=pharma_agent_lab

# Absolute path to psql.exe. Only needed by scripts/db-setup.mjs.
# Laragon default shown; adjust for your install.
PSQL_BIN=D:\laragon\bin\postgresql\postgresql\bin\psql.exe

# ---------------------------------------------------------------------------
# Model providers
#
# You need at least one. Every provider is optional and the registry skips any
# whose key is absent -- so you can start with Gemini alone and add the others
# later without touching code.
# ---------------------------------------------------------------------------

# Google AI Studio (free tier) -- https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic -- https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Any OpenAI-compatible endpoint: OpenRouter, Groq, Together, LM Studio, Ollama.
# Examples:
#   OpenRouter  https://openrouter.ai/api/v1
#   Groq        https://api.groq.com/openai/v1
#   LM Studio   http://localhost:1234/v1
#   Ollama      http://localhost:11434/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Embeddings
#
# Dimension is baked into the DB schema (768). Changing EMBEDDING_MODEL to one
# with a different dimension requires editing db/migrations/002 and re-ingesting.
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=gemini          # gemini | openai | ollama | hash
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768

# ---------------------------------------------------------------------------
# Agent defaults
# ---------------------------------------------------------------------------
AGENT_MAX_STEPS=6
RAG_TOP_K=6
RAG_MIN_SCORE=0.25
CONTEXT_TOKEN_BUDGET=12000

# Model tiers. The router picks a tier; the registry resolves a tier to a
# concrete provider:model. Format: provider:model
TIER_FAST=gemini:gemini-3.5-flash-lite
TIER_BALANCED=gemini:gemini-3.6-flash
TIER_STRONG=gemini:gemini-3.8-flash

# ---------------------------------------------------------------------------
# Servers
# ---------------------------------------------------------------------------
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
